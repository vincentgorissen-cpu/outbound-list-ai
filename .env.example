# Supabase (verplicht voor deze technische basis)
# Te vinden in je Supabase-project onder Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, nooit blootstellen aan de browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optioneel: alleen nodig als fallback wanneer een kolom bij het
# importeren niet betrouwbaar automatisch herkend kan worden.
ANTHROPIC_API_KEY=

# KVK Zoeken API (server-only, wordt nooit naar de browser gestuurd).
# Aanvragen via https://developers.kvk.nl na registratie.
KVK_API_KEY=

# Optioneel: alleen nodig om tegen de KVK-testomgeving te draaien in
# plaats van productie. Laat leeg voor productie.
# Test: https://api.kvk.nl/test/api/v2/zoeken
KVK_API_BASE_URL=
